{
  "manifest_version": 3,
  "name": "Ethical Grade",
  "description": "Shows a personalized ethical-fit grade on supported shopping pages.",
  "version": "0.3.2",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["https://www.amazon.com/*", "https://amazon.com/*", "https://world.openfoodfacts.org/*", "https://search.openfoodfacts.org/*", "https://api.nal.usda.gov/*", "https://api.brandfetch.io/*", "https://cdn.brandfetch.io/*", "https://www.oeko-tex.com/*", "https://www.vegansociety.com/*", "https://api.nongmoproject.org/*", "https://certified.greenseal.org/*", "https://www.epeat.net/*", "https://data.energystar.gov/*", "https://www.cosmos-standard.org/*", "https://apps.data.env.service.ec.europa.eu/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ethical Grade",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:"
  },
  "sandbox": {
    "pages": ["paddle-frame.html"]
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["data/certification-index.json"],
      "matches": ["https://www.amazon.com/*", "https://amazon.com/*"]
    },
    {
      "resources": ["vendor/paddleocr/ppocr-det.tar", "vendor/paddleocr/ppocr-rec.tar", "vendor/paddleocr/ort-wasm-simd-threaded.wasm", "vendor/paddleocr/ort-wasm-simd-threaded.mjs"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/*", "https://amazon.com/*"],
      "css": ["content.css"],
      "js": ["shared.js", "vendor/zxing/zxing-browser.min.js", "vendor/zbar/zbar-wasm.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
